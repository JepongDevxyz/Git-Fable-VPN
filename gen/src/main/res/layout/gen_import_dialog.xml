<?xml version="1.0" encoding="utf-8"?>
<!-- Import-into-generator dialog (admin brings a profile back in to edit).
     Fully custom chrome (no default dialog look): cc_ tokens only.
     Accepts share links, a gitfablevpn:// import link, plain profile-store
     text, or GFVENC1:... text (with the config password below). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:background="@drawable/cc_card" android:padding="18dp">

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Import profile" android:textColor="@color/cc_ink" android:textSize="16sp" android:textStyle="bold"/>

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Paste a share link, a gitfablevpn:// import link, profile text, or a GFVENC1 encrypted config."
        android:textColor="@color/cc_muted" android:textSize="12sp"/>

    <EditText android:id="@+id/cc_imp_text" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:hint="Paste config / link here" android:textColor="@color/cc_ink"
        android:textColorHint="@color/cc_muted" android:textSize="13sp" android:gravity="top"
        android:inputType="textMultiLine" android:minLines="4" android:maxLines="8"
        android:background="@drawable/cc_input" android:padding="12dp"/>

    <EditText android:id="@+id/cc_imp_pass" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" android:hint="Config password (GFVENC1 only)" android:textColor="@color/cc_ink"
        android:textColorHint="@color/cc_muted" android:textSize="13sp"
        android:inputType="textPassword" android:background="@drawable/cc_input" android:padding="12dp"/>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="16dp" android:orientation="horizontal" android:gravity="end">
        <TextView android:id="@+id/cc_imp_cancel" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Cancel" android:textColor="@color/cc_ink" android:textSize="14sp"
            android:background="@drawable/cc_chip" android:paddingHorizontal="16dp" android:paddingVertical="9dp"/>
        <TextView android:id="@+id/cc_imp_go" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="Import" android:textColor="@color/cc_on_accent" android:textSize="14sp" android:textStyle="bold"
            android:background="@drawable/cc_btn_primary" android:paddingHorizontal="18dp" android:paddingVertical="9dp"/>
    </LinearLayout>
</LinearLayout>
