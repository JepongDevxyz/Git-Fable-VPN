<?xml version="1.0" encoding="utf-8"?>
<!-- Publish-feed dialog: the built servers.txt can go out via the system
     share sheet or be saved as a file (ACTION_CREATE_DOCUMENT) so the
     admin can upload it to the repo at servers/servers.txt.
     Fully custom chrome (no default dialog look): cc_ tokens only. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:background="@drawable/cc_card" android:padding="18dp">

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Publish feed" android:textColor="@color/cc_ink" android:textSize="16sp" android:textStyle="bold"/>

    <TextView android:id="@+id/cc_pub_summary" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Feed text is ready in the Output box."
        android:textColor="@color/cc_muted" android:textSize="12sp"/>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="16dp" android:orientation="horizontal" android:gravity="end">
        <TextView android:id="@+id/cc_pub_cancel" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Cancel" android:textColor="@color/cc_ink" android:textSize="14sp"
            android:background="@drawable/cc_chip" android:paddingHorizontal="16dp" android:paddingVertical="9dp"/>
        <TextView android:id="@+id/cc_pub_share" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="Share" android:textColor="@color/cc_ink" android:textSize="14sp"
            android:background="@drawable/cc_chip" android:paddingHorizontal="16dp" android:paddingVertical="9dp"/>
        <TextView android:id="@+id/cc_pub_save" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="Save servers.txt" android:textColor="@color/cc_on_accent" android:textSize="14sp" android:textStyle="bold"
            android:background="@drawable/cc_btn_primary" android:paddingHorizontal="18dp" android:paddingVertical="9dp"/>
    </LinearLayout>
</LinearLayout>
