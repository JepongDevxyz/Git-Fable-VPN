<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
     xmlns:android="http://schemas.android.com/apk/res/android"
     xmlns:app="http://schemas.android.com/apk/res-auto"
     android:layout_height="match_parent"
     android:background="@drawable/ic_bgcore"
     android:layout_width="match_parent">

    <com.google.android.material.appbar.AppBarLayout
         android:layout_height="50dp"
         android:layout_width="match_parent"
         app:cardBackgroundColor="@color/transfigure"
         android:background="@color/transfigure"
         android:id="@+id/main_toolbar">

        <LinearLayout
             android:layout_height="50dp"
             android:layout_width="match_parent"
             android:gravity="center"
             app:cardBackgroundColor="@color/transfigure"
             android:background="@color/transfigure"
             android:orientation="vertical">

            <LinearLayout
                 android:layout_height="wrap_content"
                 android:layout_width="match_parent"
                 android:gravity="center"
                 android:orientation="horizontal">

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="wrap_content"
                     android:gravity="center|bottom"
                     app:cardBackgroundColor="@color/transfigure"
                     android:background="@color/transfigure"
                     android:textAppearance="@style/ToolbarTitleTheme"
                     android:textColor="@android:color/holo_red_dark"
                     android:text="Git Fable" />

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="wrap_content"
                     android:gravity="center|bottom"
                     app:cardBackgroundColor="@color/transfigure"
                     android:background="@color/transfigure"
                     android:textAppearance="@style/ToolbarTitleTheme"
                     android:layout_marginLeft="5dp"
                     android:text="OVPN - Core 3" />

            </LinearLayout>

            <TextView
                 android:layout_height="wrap_content"
                 android:layout_width="wrap_content"
                 android:gravity="center|top"
                 android:textAppearance="@style/ToolbarSubtitleTheme"
                 android:text="Jay-Ar Lee Espiritu" />

        </LinearLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <ListView
         android:layout_height="fill_parent"
         android:layout_width="fill_parent"
         android:layout_marginBottom="10dp"
         android:transcriptMode="normal"
         android:layout_marginLeft="10dp"
         android:layout_marginRight="10dp"
         android:layout_marginTop="55dp"
         android:id="@android:id/list">

    </ListView>

    <ImageButton
         android:layout_height="wrap_content"
         android:layout_width="wrap_content"
         android:src="@android:drawable/ic_menu_delete"
         android:background="#00000000"
         android:layout_margin="20dp"
         app:tint="@color/red"
         android:layout_alignParentRight="true"
         android:layout_alignParentBottom="true"
         android:id="@+id/clearLogs" />

</RelativeLayout>