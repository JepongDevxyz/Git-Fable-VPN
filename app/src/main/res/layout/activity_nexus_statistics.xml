<?xml version="1.0" encoding="utf-8"?>
<!-- Statistics (Nexus bottom-nav): live connection state, uptime, session
     totals + speeds, traffic chart, Logs. All values are fed by
     NexusStatisticsActivity from hLogStatus / OpenVPNService /
     DataTransferStats — nothing here is display-only. Theme tokens only. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/cc_bg">

    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
        android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="8dp">
        <TextView android:id="@+id/cc_stat_back" android:layout_width="48dp" android:layout_height="match_parent"
            android:text="←" android:textColor="@color/cc_ink" android:textSize="20sp" android:gravity="center"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="Statistics" android:textColor="@color/cc_ink" android:textSize="17sp"
            android:textStyle="bold" android:gravity="center"/>
        <TextView android:layout_width="48dp" android:layout_height="match_parent"/>
    </LinearLayout>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="16dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@drawable/cc_card" android:orientation="vertical" android:padding="16dp">
                <TextView android:id="@+id/cc_stat_state" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="State: Disconnected" android:textColor="@color/cc_ink" android:textSize="15sp" android:textStyle="bold"/>
                <TextView android:id="@+id/cc_stat_server" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" android:text="Server: —" android:textColor="@color/cc_ink" android:textSize="13sp"/>
                <TextView android:id="@+id/cc_stat_uptime" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" android:text="Uptime: 00:00:00" android:textColor="@color/cc_connected" android:textSize="13sp"/>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="14dp" android:background="@drawable/cc_card"
                android:orientation="vertical" android:padding="16dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Downloaded (session)" android:textColor="@color/cc_muted" android:textSize="12sp"/>
                        <TextView android:id="@+id/cc_stat_total_down" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="@color/cc_graph_down" android:textSize="15sp" android:textStyle="bold"/>
                        <TextView android:id="@+id/cc_stat_speed_down" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="0 Mbps" android:textColor="@color/cc_ink" android:textSize="13sp"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="end">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Uploaded (session)" android:textColor="@color/cc_muted" android:textSize="12sp"/>
                        <TextView android:id="@+id/cc_stat_total_up" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="@color/cc_graph_up" android:textSize="15sp" android:textStyle="bold"/>
                        <TextView android:id="@+id/cc_stat_speed_up" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="0 Mbps" android:textColor="@color/cc_ink" android:textSize="13sp"/>
                    </LinearLayout>
                </LinearLayout>
                <com.github.mikephil.charting.charts.LineChart android:id="@+id/cc_stat_chart"
                    android:layout_width="match_parent" android:layout_height="140dp" android:layout_marginTop="10dp"/>
            </LinearLayout>

            <TextView android:id="@+id/cc_stat_logs" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:text="Logs" android:gravity="center"
                android:textColor="@color/cc_on_accent" android:textSize="15sp" android:textStyle="bold"
                android:background="@drawable/cc_btn_primary" android:paddingVertical="13dp"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
